# Copy this file to .env for local development (never commit the real .env)

# Leave MONGODB_URI unset to run in LOCAL mode - a JSON file at
# server/data/db.json is used automatically, zero setup required.
# Set it to a MongoDB Atlas connection string for the production
# Vercel deployment (Vercel's filesystem cannot persist data).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agrifinance

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=agrifinance-dev-secret-change-in-production

# Code a farm owner enters at /register to be granted the admin role.
# Change this before deploying.
ADMIN_INVITE_CODE=FARM54-OWNER

PORT=3000

# Enables the AI Farm Assistant (chat + proactive insights on the dashboard).
# Get a key at https://console.anthropic.com. Without this set, the app still
# works fully - the assistant panel shows a friendly "not configured" message
# and the rule-based /api/notifications alerts keep working regardless.
# ANTHROPIC_API_KEY=sk-ant-...
